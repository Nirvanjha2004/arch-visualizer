# ============================================================
#  ENVIRONMENT VARIABLES — copy to .env and fill in values
# ============================================================

# GitHub Personal Access Token (free, no credit card needed)
# Create at: https://github.com/settings/tokens → "Generate new token (classic)"
# Required scopes: public_repo (read-only is fine)
GITHUB_PAT=ghp_your_token_here

# ----- LLM Provider (pick ONE, both are free tier) ----------

# Option A: Groq — https://console.groq.com  (free, no CC required)
GROQ_API_KEY=gsk_your_groq_key_here

# Option B: Google Gemini — https://aistudio.google.com/app/apikey (free, no CC)
GEMINI_API_KEY=your_gemini_key_here

# Which LLM provider to use: "groq" or "gemini"
LLM_PROVIDER=groq

# ---- Eraser.io API key for MCP server ---------------------
# Create at: https://app.eraser.io/settings/api  (free tier available)
ERASER_API_KEY=your_eraser_api_key_here

# ---- App config -------------------------------------------
BACKEND_CORS_ORIGINS=["http://localhost:5173","https://your-vercel-app.vercel.app"]
LOG_LEVEL=INFO
